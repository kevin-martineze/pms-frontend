# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# La plantilla sí se versiona: es la única documentación de qué variables
# necesita el proyecto y no contiene valores reales.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fotografía del cliente. Son imágenes privadas de una propiedad real y este
# repositorio es público: viven sólo en la máquina de desarrollo. Ver
# public/photos/README.md para la lista de archivos que espera la demo.
/public/photos/*
!/public/photos/README.md
